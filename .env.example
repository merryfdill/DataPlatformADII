# MinIO
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

MINIO_ENDPOINT=http://minio:9000
# Host-reachable equivalent of MINIO_ENDPOINT, for scripts run outside Docker
# (e.g. ingestion/bronze_ingestion.py) - uses the port published in docker-compose.yml.
MINIO_ENDPOINT_HOST=http://localhost:9000
MINIO_BUCKET=datalake

# Airflow
AIRFLOW_UID=50000
AIRFLOW_WEBSERVER_SECRET_KEY=change-me-dev-secret-key
# Shared key for the task-identity JWT (scheduler signs, api-server validates).
# MUST be identical across all airflow containers. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
AIRFLOW_JWT_SECRET=change-me-generate-a-64-char-hex-secret
_AIRFLOW_WWW_USER_USERNAME=admin
_AIRFLOW_WWW_USER_PASSWORD=admin

# Airflow metadata database (Postgres)
POSTGRES_USER=airflow
POSTGRES_PASSWORD=airflow
POSTGRES_DB=airflow

# Trino
TRINO_HOST=trino
TRINO_PORT=8080

# Iceberg
ICEBERG_CATALOG=rest
ICEBERG_REST_URI=http://iceberg-rest:8181

# S3
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_REGION=us-east-1

# Grafana
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# Chatbot (Phase 2.24, LLM swapped to Gemini in Phase 2.25) - never commit the real key
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
